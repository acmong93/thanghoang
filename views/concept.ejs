<!DOCTYPE html>
<html lang="vi">
<head>
<%- include('partials/head', { title: 'Concept chụp ảnh cưới', desc: 'Kho concept chụp ảnh cưới tại Rosé Wedding: studio phim trường, editorial tạp chí, áo dài, ngoại cảnh. Xem ảnh thật từng concept để chọn phong cách cho ngày trọng đại.' }) %>
<link rel="stylesheet" href="/css/concept.css?v=<%= v %>" />
</head>
<body>
<%- include('partials/header', { solidHeader: true }) %>

<main id="main">
<section class="page-hero cc-hero">
  <div class="wrap center">
    <span class="eyebrow gold">Kho concept của Rosé</span>
    <h1>Chọn <span class="italic">concept</span> của hai bạn</h1>
    <p><%= categories.length %> hạng mục, <%= total %> concept chụp thật cho khách tại Rosé. Chọn một hạng mục để xem toàn bộ concept, chạm vào từng concept để xem ảnh lớn.</p>
  </div>
</section>

<section class="cc-cats-sec">
  <div class="wrap-wide">
    <div class="cc-cats">
      <% categories.forEach((c, i) => { const cv = c.cover || {}; %>
      <a class="cc-cat reveal" href="/concept/<%= c.slug %>">
        <span class="cc-cat-frame">
          <img src="<%= cv.thumb || cv.file %>"
            <% if (cv.thumb && cv.file) { %>srcset="<%= cv.thumb %> 640w, <%= cv.file %> 1600w" sizes="(max-width:680px) 92vw, 46vw"<% } %>
            alt="Hạng mục concept <%= c.name %>" loading="<%= i < 2 ? 'eager' : 'lazy' %>" decoding="async" />
        </span>
        <span class="cc-cat-meta">
          <span class="cc-cat-count"><%= c.count %> concept</span>
          <h2><%= c.name %></h2>
          <% if (c.desc) { %><span class="cc-cat-desc"><%= c.desc %></span><% } %>
          <span class="cc-cat-go">Xem concept<span aria-hidden="true">&ensp;&rsaquo;</span></span>
        </span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="cta-band reveal">
  <div class="wrap center">
    <h2>Chưa biết chọn concept <span class="italic">nào?</span></h2>
    <p class="mt-14">Nhắn Rosé đôi điều về hai bạn, chúng tôi sẽ gợi ý concept hợp nhất với câu chuyện và ngân sách của bạn.</p>
    <a href="/#booking" class="btn btn-gold mt-24">Nhận tư vấn miễn phí</a>
  </div>
</section>
</main>

<%- include('partials/footer') %>
</body>
</html>
