<!DOCTYPE html>
<html lang="vi">
<head>
<%# Trang chính của một "kho tư vấn" (concept hoặc báo giá) — cấu hình ở KHO trong src/routes/public.js %>
<%- include('partials/head', { title: kho.title, desc: kho.desc }) %>
<link rel="stylesheet" href="/css/concept.css?v=<%= v %>" />
</head>
<body>
<%- include('partials/header', { solidHeader: true }) %>

<main id="main">
<section class="page-hero cc-hero">
  <div class="wrap center">
    <span class="eyebrow gold"><%= kho.eyebrow %></span>
    <h1><%= kho.headA %><span class="italic"><%= kho.headEm %></span><%= kho.headB %></h1>
    <p><%= kho.intro(categories.length, total) %></p>
  </div>
</section>

<section class="cc-cats-sec">
  <div class="wrap-wide">
    <div class="cc-cats">
      <% categories.forEach((c, i) => { const cv = c.cover || {}; %>
      <a class="cc-cat reveal" href="<%= kho.base %>/<%= c.slug %>">
        <span class="cc-cat-frame">
          <img src="<%= cv.thumb || cv.file %>"
            <% const css = srcsetFor(cv); if (css) { %>srcset="<%= css %>" sizes="(max-width:680px) calc(90vw - 50px), (max-width:1100px) calc(44vw - 33px), (max-width:1400px) calc(22vw - 24px), 290px"<% } %>
            alt="<%= kho.item %> <%= c.name %>" loading="<%= i < 2 ? 'eager' : 'lazy' %>" decoding="async" />
        </span>
        <span class="cc-cat-meta">
          <span class="cc-cat-count"><%= c.count %> <%= kho.unit %></span>
          <h2><%= c.name %></h2>
          <% if (c.desc) { %><span class="cc-cat-desc"><%= c.desc %></span><% } %>
          <span class="cc-cat-go">Xem <%= kho.unit %><span aria-hidden="true">&ensp;&rsaquo;</span></span>
        </span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="cta-band reveal">
  <div class="wrap center">
    <h2><%= kho.ask.replace(kho.askEm, '') %><span class="italic"><%= kho.askEm %></span></h2>
    <p class="mt-14"><%= kho.cta %></p>
    <a href="/#booking" class="btn btn-gold mt-24">Nhận tư vấn miễn phí</a>
  </div>
</section>
</main>

<%- include('partials/footer') %>
</body>
</html>
