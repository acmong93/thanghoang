<!DOCTYPE html>
<html lang="vi">
<head>
<%- include('partials/head', { title: 'Concept ' + album.name, desc: album.desc || ('Bộ concept ' + album.name + ' tại Rosé Wedding'),
  og: images.length ? images[0].file : '',
  crumbs: [['Concept', '/concept'], ['Concept ' + album.name, null]] }) %>
<link rel="stylesheet" href="/css/concept.css?v=<%= v %>" />
</head>
<body>
<%- include('partials/header', { solidHeader: true }) %>

<main id="main">
<section class="page-hero cc-hero cc-hero-cat">
  <div class="wrap center">
    <a class="cc-back" href="/concept"><span aria-hidden="true">&lsaquo;&ensp;</span>Tất cả hạng mục</a>
    <h1><%= album.name %></h1>
    <% if (album.desc) { %><p><%= album.desc %></p><% } %>
    <p class="cc-count"><%= images.length %> concept chụp thật tại Rosé<span class="cc-count-hint"> · chạm vào concept để xem ảnh lớn</span></p>
  </div>
</section>

<% if (categories.length > 1) { %>
<nav class="cc-tabs" aria-label="Hạng mục concept">
  <div class="cc-tabs-in">
    <% categories.forEach(c => { const on = c.id === album.id; %>
    <a href="/concept/<%= c.slug %>" class="cc-tab<%= on ? ' on' : '' %>"<%- on ? ' aria-current="page"' : '' %>><%= c.name %><span class="cc-tab-n"><%= c.count %></span></a>
    <% }) %>
  </div>
</nav>
<% } %>

<section class="cc-gal-sec" id="concept-list">
  <div class="wrap-wide">
    <!-- Lưới so le theo tỉ lệ thật của từng bảng concept (không cắt ảnh). JS xếp ô vào cột thấp nhất,
         giữ thứ tự kéo thả: 3 concept đầu nằm trên cùng. Không JS thì CSS columns vẫn hiển thị đủ. -->
    <div class="cc-gal" id="ccGal" data-name="<%= album.name %>" data-zalo="<%= (s.zalo || '').replace(/\D/g, '') %>">
      <% images.forEach((im, i) => { const w = im.w || 1, h = im.h || 1; %>
      <a class="cc-it" href="<%= im.file %>" data-i="<%= i %>" data-w="<%= w %>" data-h="<%= h %>"<% if (im.thumb) { %> data-thumb="<%= im.thumb %>"<% } %> style="aspect-ratio:<%= w %>/<%= h %>">
        <img src="<%= im.thumb || im.file %>"
          <% if (im.thumb) { %>srcset="<%= im.thumb %> 640w, <%= im.file %> 1600w" sizes="(max-width:680px) 96vw, (max-width:1100px) 48vw, 460px"<% } %>
          width="<%= w %>" height="<%= h %>"
          alt="<%= album.name %> · concept <%= i + 1 %>" loading="<%= i < 6 ? 'eager' : 'lazy' %>" decoding="async" />
        <span class="cc-it-n" aria-hidden="true">Concept <%= i + 1 %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<% if (nextCat) { %>
<section class="cc-next">
  <a class="cc-next-in wrap" href="/concept/<%= nextCat.slug %>">
    <span class="eyebrow">Hạng mục tiếp theo</span>
    <span class="cc-next-name"><%= nextCat.name %><span class="cc-next-arrow" aria-hidden="true">&rsaquo;</span></span>
    <span class="cc-next-count"><%= nextCat.count %> concept</span>
  </a>
</section>
<% } %>

<section class="cta-band reveal">
  <div class="wrap center">
    <h2>Thích concept <span class="italic">nào?</span></h2>
    <p class="mt-14">Gửi Rosé concept hai bạn ưng ý (ví dụ “<%= album.name %> · Concept 12”), chúng tôi tư vấn chi tiết và giữ lịch cho riêng hai bạn, hoàn toàn miễn phí.</p>
    <a href="/#booking" class="btn btn-gold mt-24">Đặt lịch tư vấn</a>
  </div>
</section>
</main>

<%- include('partials/footer') %>
<script src="/js/concept.js?v=<%= v %>" defer></script>
</body>
</html>
