<%- include('partials/top', { t: 'Thống kê truy cập' }) %>

<h1>
  Thống kê truy cập
  <span class="kfilter">
    <a class="ad-btn sm <%= days === 7 ? 'primary' : '' %>" href="/admin/thong-ke?d=7">7 ngày</a>
    <a class="ad-btn sm <%= days === 30 ? 'primary' : '' %>" href="/admin/thong-ke?d=30">30 ngày</a>
    <a class="ad-btn sm <%= days === 90 ? 'primary' : '' %>" href="/admin/thong-ke?d=90">90 ngày</a>
  </span>
</h1>

<div class="stats">
  <div class="stat"><b><%= kpi.visitors.toLocaleString('vi-VN') %></b><span>Khách (<%= days %> ngày)</span></div>
  <div class="stat"><b><%= kpi.views.toLocaleString('vi-VN') %></b><span>Lượt xem trang</span></div>
  <div class="stat"><b><%= kpi.contacts.toLocaleString('vi-VN') %></b><span>Lượt bấm liên hệ</span></div>
  <div class="stat"><b><%= kpi.conv %>%</b><span>Khách bấm liên hệ</span></div>
</div>
<p class="muted" style="margin:-10px 0 22px">
  Hôm nay: <b><%= kpi.today.visitors %></b> khách · <%= kpi.today.views %> lượt xem · <%= kpi.today.contacts %> lượt bấm liên hệ
</p>

<div class="panel">
  <h2 style="margin-top:0">Khách theo ngày <span class="muted" style="font-weight:400;font-size:13px">· cột vàng: khách · vạch sẫm: lượt bấm liên hệ</span></h2>
  <%
    const W = 940, H = 210, padL = 34, padB = 20;
    const maxV = Math.max(1, ...series.map(r => r.visitors));
    const bw = (W - padL) / series.length;
    const y = v => H - padB - (v / maxV) * (H - padB - 14);
  %>
  <div class="chartwrap">
    <svg viewBox="0 0 <%= W %> <%= H %>" role="img" aria-label="Biểu đồ khách theo ngày">
      <% [1, 0.5].forEach(f => { %>
      <line x1="<%= padL %>" y1="<%= y(maxV * f) %>" x2="<%= W %>" y2="<%= y(maxV * f) %>" stroke="#E5E0D6" stroke-width="1" />
      <text x="<%= padL - 6 %>" y="<%= y(maxV * f) + 4 %>" text-anchor="end" font-size="10" fill="#6B6560"><%= Math.round(maxV * f) %></text>
      <% }) %>
      <line x1="<%= padL %>" y1="<%= H - padB %>" x2="<%= W %>" y2="<%= H - padB %>" stroke="#CFC8BA" stroke-width="1" />
      <% series.forEach((r, i) => {
           const x = padL + i * bw;
           const lbl = r.day.slice(8) + '/' + r.day.slice(5, 7);
      %>
      <g>
        <title><%= lbl %>: <%= r.visitors %> khách · <%= r.views %> lượt xem · <%= r.contacts %> liên hệ</title>
        <rect x="<%= x + bw * 0.18 %>" y="<%= y(r.visitors) %>" width="<%= bw * 0.64 %>" height="<%= Math.max(0, H - padB - y(r.visitors)) %>" fill="#B08D57" opacity=".9" rx="2" />
        <% if (r.contacts) { %>
        <rect x="<%= x + bw * 0.18 %>" y="<%= y(r.contacts) %>" width="<%= bw * 0.64 %>" height="3" fill="#1C1917" rx="1.5" />
        <% } %>
        <% if (series.length <= 31 ? i % 3 === 0 : i % 7 === 0) { %>
        <text x="<%= x + bw / 2 %>" y="<%= H - 6 %>" text-anchor="middle" font-size="9.5" fill="#6B6560"><%= lbl %></text>
        <% } %>
      </g>
      <% }) %>
    </svg>
  </div>
</div>

<div class="cols2">
  <div class="panel">
    <h2 style="margin-top:0">Nguồn khách tới</h2>
    <%
      const srcName = { '': 'Trực tiếp / gõ địa chỉ', facebook: 'Facebook', instagram: 'Instagram', tiktok: 'TikTok', google: 'Tìm kiếm Google', zalo: 'Zalo', youtube: 'YouTube', bing: 'Bing', coccoc: 'Cốc Cốc', khac: 'Nguồn khác' };
      const maxSrc = Math.max(1, ...sources.map(s => s.v));
    %>
    <% if (!sources.length) { %><p class="muted">Chưa có dữ liệu. Số liệu bắt đầu được ghi từ khi bản này lên web.</p><% } %>
    <% sources.forEach(s => { %>
    <div class="hbar">
      <span class="hbar-l"><%= srcName[s.src] || s.src %></span>
      <span class="hbar-track"><i style="width:<%= Math.round(s.v / maxSrc * 100) %>%"></i></span>
      <b class="hbar-v"><%= s.v %></b>
    </div>
    <% }) %>
  </div>

  <div class="panel">
    <h2 style="margin-top:0">Trang được xem nhiều</h2>
    <%
      const pageName = p => ({ '/': 'Trang chủ', '/anh-cuoi': 'Ảnh Cưới', '/vay-cuoi': 'Váy Cưới', '/phong-su': 'Phóng Sự', '/cau-chuyen': 'Về Rosé', '/tin-tuc': 'Tin tức' }[p]
        || (p.startsWith('/bang-gia') ? 'Bảng giá ' + p.split('/')[2] : p.startsWith('/album/') ? 'Album ' + p.split('/')[2] : p.startsWith('/tin-tuc/') ? 'Bài viết ' + p.split('/')[2] : p));
      const maxPg = Math.max(1, ...topPages.map(t => t.n));
    %>
    <% if (!topPages.length) { %><p class="muted">Chưa có dữ liệu.</p><% } %>
    <% topPages.forEach(t => { %>
    <div class="hbar">
      <span class="hbar-l" title="<%= t.path %>"><%= pageName(t.path) %></span>
      <span class="hbar-track"><i style="width:<%= Math.round(t.n / maxPg * 100) %>%"></i></span>
      <b class="hbar-v"><%= t.n %></b>
    </div>
    <% }) %>
  </div>
</div>

<div class="cols2">
  <div class="panel">
    <h2 style="margin-top:0">Kênh liên hệ được bấm</h2>
    <%
      const chName = { zalo: 'Chat Zalo', messenger: 'Messenger', call: 'Gọi điện', booking: 'Nút Đặt lịch', facebook: 'Facebook', instagram: 'Instagram', tiktok: 'TikTok', youtube: 'YouTube' };
      const maxCh = Math.max(1, ...channels.map(c => c.n));
    %>
    <% if (!channels.length) { %><p class="muted">Chưa có lượt bấm nào trong khoảng này.</p><% } %>
    <% channels.forEach(c => { %>
    <div class="hbar">
      <span class="hbar-l"><%= chName[c.label] || c.label %></span>
      <span class="hbar-track"><i style="width:<%= Math.round(c.n / maxCh * 100) %>%"></i></span>
      <b class="hbar-v"><%= c.n %></b>
    </div>
    <% }) %>
  </div>

  <div class="panel">
    <h2 style="margin-top:0">Thiết bị</h2>
    <%
      const totalDev = Math.max(1, devices.reduce((a, d) => a + d.v, 0));
      const devName = { mobile: 'Điện thoại', desktop: 'Máy tính' };
    %>
    <% devices.forEach(d => { %>
    <div class="hbar">
      <span class="hbar-l"><%= devName[d.device] || d.device %></span>
      <span class="hbar-track"><i style="width:<%= Math.round(d.v / totalDev * 100) %>%"></i></span>
      <b class="hbar-v"><%= Math.round(d.v / totalDev * 100) %>%</b>
    </div>
    <% }) %>
    <p class="muted" style="margin-top:18px;font-size:12.5px">
      Số liệu ẩn danh hoàn toàn (không lưu IP hay thông tin cá nhân), do website tự ghi nên không bị chặn bởi trình chặn quảng cáo. "Khách" đếm theo trình duyệt trong ngày.
    </p>
  </div>
</div>

<%- include('partials/bottom') %>
