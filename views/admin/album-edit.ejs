<%- include('partials/top', { t: album.name }) %>

<% const isConcept = album.category === 'concept'; %>
<p><a href="<%= isConcept ? '/admin/concepts' : '/admin/albums' %>" class="muted">← <%= isConcept ? 'Tất cả concept' : 'Tất cả album' %></a></p>
<h1><%= album.name %> <a class="ad-btn sm" href="<%= isConcept ? '/concept/' + album.slug : '/album/' + album.slug %>" target="_blank" rel="noopener">Xem trên web ↗</a></h1>

<form method="post" action="/admin/albums/<%= album.id %>" class="panel grid-form">
  <label>Tên <%= isConcept ? 'concept' : 'album' %> <input name="name" value="<%= album.name %>" required /></label>
  <label>Tag hiển thị <input name="tag" value="<%= album.tag %>" /></label>
  <% if (isConcept) { %>
  <label>Nhóm concept <input name="grp" value="<%= album.grp %>" /></label>
  <% } else { %>
  <label>Nhóm
    <select name="category">
      <option value="wedding" <%= album.category === 'wedding' ? 'selected' : '' %>>Ảnh cưới</option>
      <option value="signature" <%= album.category === 'signature' ? 'selected' : '' %>>Concept độc bản</option>
      <option value="phong-su" <%= album.category === 'phong-su' ? 'selected' : '' %>>Phóng sự</option>
    </select>
  </label>
  <% } %>
  <label>Thứ tự <input name="sort_order" type="number" value="<%= album.sort_order %>" /></label>
  <label class="full">Mô tả <textarea name="desc" rows="4"><%= album.desc %></textarea></label>
  <label class="check"><input type="checkbox" name="visible" <%= album.visible ? 'checked' : '' %> /> Hiển thị trên website</label>
  <div class="row-btns">
    <button type="submit" class="ad-btn primary">Lưu thay đổi</button>
  </div>
</form>

<form method="post" action="/admin/albums/<%= album.id %>/delete" onsubmit="return confirm('Xoá album này cùng toàn bộ ảnh trong đó? Không thể hoàn tác.')" class="inline-form">
  <button type="submit" class="ad-btn danger sm">Xoá album</button>
</form>

<h2>Ảnh trong album (<%= images.length %>)</h2>
<form method="post" action="/admin/albums/<%= album.id %>/images" enctype="multipart/form-data" class="panel upload-form">
  <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple required />
  <button type="submit" class="ad-btn primary">Tải ảnh lên (tự nén WebP)</button>
  <span class="muted">Chọn được nhiều ảnh cùng lúc · tối đa 30MB/ảnh</span>
</form>

<p class="muted" style="margin:-6px 0 14px"><b>Giữ chuột vào ảnh rồi kéo thả</b> để đưa tới thẳng vị trí muốn (thả là tự lưu). Nút ← → vẫn dùng được để nhích từng nấc. Thanh kéo dưới mỗi ảnh dùng để <b>căn phần ảnh được giữ lại</b> khi thumbnail bị cắt (VD ảnh dọc bị mất mặt: kéo về phía trên).</p>

<div class="img-grid" id="img-grid">
  <% images.forEach(im => { %>
  <div class="img-cell <%= im.is_cover ? 'cover' : '' %>" draggable="true" data-id="<%= im.id %>">
    <img src="<%= im.thumb || im.file %>" alt="" loading="lazy" style="object-position:<%= im.pos || '50% 50%' %>" id="imprev-<%= im.id %>" />
    <% if (im.is_cover) { %><span class="cover-tag">Ảnh bìa</span><% } %>
    <div class="img-actions">
      <form method="post" action="/admin/images/<%= im.id %>/move"><input type="hidden" name="dir" value="up" /><button title="Lên trước">←</button></form>
      <form method="post" action="/admin/images/<%= im.id %>/move"><input type="hidden" name="dir" value="down" /><button title="Xuống sau">→</button></form>
      <% if (!im.is_cover) { %>
      <form method="post" action="/admin/images/<%= im.id %>/cover"><button title="Đặt làm ảnh bìa">★</button></form>
      <% } %>
      <form method="post" action="/admin/images/<%= im.id %>/replace" enctype="multipart/form-data" class="inline-form">
        <label class="img-replace" title="Thay bằng ảnh khác từ máy tính">
          ⇄<input type="file" name="photo" accept="image/jpeg,image/png,image/webp" onchange="this.form.submit()" hidden />
        </label>
      </form>
      <form method="post" action="/admin/images/<%= im.id %>/delete" onsubmit="return confirm('Xoá ảnh này?')"><button title="Xoá" class="danger">✕</button></form>
    </div>
    <div class="pos-ctl" title="Căn phần ảnh hiển thị khi bị cắt: kéo trái = lấy phần trên, kéo phải = lấy phần dưới">
      <span>↑</span>
      <input type="range" min="0" max="100" step="5"
        value="<%= parseInt((im.pos || '50% 50%').split(' ')[1]) || 50 %>"
        data-id="<%= im.id %>" class="pos-slider" aria-label="Căn vị trí dọc của ảnh" />
      <span>↓</span>
    </div>
  </div>
  <% }) %>
</div>

<div class="cc-toast" id="img-toast">Đã lưu thứ tự ảnh</div>

<script>
// Kéo thả sắp xếp ảnh: nhấc ảnh thả vào vị trí bất kỳ (VD ảnh 59 lên vị trí 2),
// thả là lưu cả dãy thứ tự; Esc hoặc thả ra ngoài là hoàn tác
(function () {
  var grid = document.getElementById('img-grid');
  if (!grid) return;
  var dragging = null, origin = null, toastT;
  var toast = document.getElementById('img-toast');

  function save() {
    var ids = [].map.call(grid.querySelectorAll('.img-cell'), function (c) { return c.dataset.id; });
    fetch('/admin/albums/<%= album.id %>/images/reorder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids: ids })
    }).then(function (r) {
      if (r.ok) {
        toast.classList.add('show');
        clearTimeout(toastT);
        toastT = setTimeout(function () { toast.classList.remove('show'); }, 1600);
      } else { alert('Chưa lưu được thứ tự ảnh, thử lại giúp anh.'); }
    }).catch(function () { alert('Mất mạng? Chưa lưu được thứ tự ảnh.'); });
  }

  grid.querySelectorAll('.img-cell').forEach(function (cell) {
    cell.addEventListener('dragstart', function (e) {
      dragging = cell;
      origin = { next: cell.nextElementSibling };
      cell.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
      try { e.dataTransfer.setData('text/plain', cell.dataset.id); } catch (err) {}
    });
    cell.addEventListener('dragend', function (e) {
      cell.classList.remove('dragging');
      dragging = null;
      if (e.dataTransfer && e.dataTransfer.dropEffect === 'none' && origin) {
        grid.insertBefore(cell, origin.next); // hủy kéo: trả về chỗ cũ, không lưu
        origin = null;
        return;
      }
      origin = null;
      save();
    });
  });

  grid.addEventListener('dragover', function (e) {
    if (!dragging) return;
    e.preventDefault();
    // Lưới nhiều cột: chèn trước ô đầu tiên nằm "sau" con trỏ theo trật tự đọc (trái→phải, trên→xuống)
    var after = null;
    grid.querySelectorAll('.img-cell:not(.dragging)').forEach(function (c) {
      if (after) return;
      var r = c.getBoundingClientRect();
      if (e.clientY < r.top + r.height / 2 ||
          (e.clientY < r.bottom && e.clientX < r.left + r.width / 2)) after = c;
    });
    if (after) grid.insertBefore(dragging, after);
    else grid.appendChild(dragging);
  });
})();

// Căn vị trí crop: xem trước ngay trên thumbnail, tự lưu sau khi ngừng kéo 0.4s
document.querySelectorAll('.pos-slider').forEach(sl => {
  let t;
  sl.addEventListener('input', () => {
    const id = sl.dataset.id;
    document.getElementById('imprev-' + id).style.objectPosition = '50% ' + sl.value + '%';
    clearTimeout(t);
    t = setTimeout(() => {
      fetch('/admin/images/' + id + '/pos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ x: 50, y: Number(sl.value) })
      }).then(r => { if (r.ok) sl.classList.add('saved'); setTimeout(() => sl.classList.remove('saved'), 900); });
    }, 400);
  });
});
</script>

<%- include('partials/bottom') %>
